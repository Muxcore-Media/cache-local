# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=cache-local

# Module gRPC listen address (default :9602 — not :9600 which is cache-redis)
# CACHE_LOCAL_GRPC_ADDR=:9602

# Default TTL for new cache entries (Go duration)
# CACHE_LOCAL_TTL=5m

# Memory limits
# CACHE_LOCAL_MAX_BYTES=268435456
# CACHE_LOCAL_MAX_ENTRY_BYTES=33554432
# CACHE_LOCAL_MAX_ENTRIES=0
