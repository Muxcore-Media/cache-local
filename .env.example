# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=cache-local

# Module gRPC listen address (loopback by default; TLS enabled unless MUXCORE_INSECURE_DISABLE_TLS=true)
# CACHE_LOCAL_GRPC_ADDR=127.0.0.1:9602

# Default TTL for new cache entries (Go duration)
# CACHE_LOCAL_TTL=5m
